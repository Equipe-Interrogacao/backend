{
  "info": {
    "name": "ASG — API Completa",
    "_postman_id": "asg-api-collection-v1",
    "description": "Collection completa da plataforma ASG.\n\nServiços:\n- **Gerenciamento do Banco** → :8004\n- **Ingestão de Dados** → :8001\n- **Cruzamento ASG** → :8002\n- **Busca Semântica** → :8003\n\nVariáveis de ambiente configuradas na própria collection (sem precisar de Environment separado).",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "url_banco",     "value": "http://localhost:8004" },
    { "key": "url_ingestao",  "value": "http://localhost:8001" },
    { "key": "url_cruzamento","value": "http://localhost:8002" },
    { "key": "url_busca",     "value": "http://localhost:8003" },
    { "key": "cod_car",       "value": "SP-3525300-44AA2FE43D774264B9F18E55658E70FA" }
  ],
  "item": [

    {
      "name": "Gerenciamento do Banco (:8004)",
      "item": [

        {
          "name": "Stats por UF",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{url_banco}}/banco/propriedades/stats",
              "host": ["{{url_banco}}"],
              "path": ["banco", "propriedades", "stats"]
            },
            "description": "Retorna contagem total de propriedades agrupada por UF."
          }
        },

        {
          "name": "Listar propriedades",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{url_banco}}/banco/propriedades?uf=SP&limit=10&offset=0",
              "host": ["{{url_banco}}"],
              "path": ["banco", "propriedades"],
              "query": [
                { "key": "uf",            "value": "SP",  "description": "Sigla do estado" },
                { "key": "municipio",     "value": "",    "description": "Nome parcial do município", "disabled": true },
                { "key": "status_imovel", "value": "",    "description": "AT | PE | CA | SU", "disabled": true },
                { "key": "limit",         "value": "10"  },
                { "key": "offset",        "value": "0"   }
              ]
            },
            "description": "Lista propriedades com filtros opcionais."
          }
        },

        {
          "name": "Buscar por código CAR",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{url_banco}}/banco/propriedades/car/{{cod_car}}",
              "host": ["{{url_banco}}"],
              "path": ["banco", "propriedades", "car", "{{cod_car}}"]
            }
          }
        },

        {
          "name": "Buscar por ID interno",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{url_banco}}/banco/propriedades/1",
              "host": ["{{url_banco}}"],
              "path": ["banco", "propriedades", "1"]
            }
          }
        },

        {
          "name": "Upsert de propriedade",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"cod_imovel\": \"SP-3525300-44AA2FE43D774264B9F18E55658E70FA\",\n  \"status_imovel\": \"AT\",\n  \"area\": 150.5,\n  \"condicao\": \"Aguardando análise\",\n  \"uf\": \"SP\",\n  \"municipio\": \"Campinas\",\n  \"cod_municipio_ibge\": \"3509502\",\n  \"tipo_imovel\": \"IRU\"\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": {
              "raw": "{{url_banco}}/banco/propriedades",
              "host": ["{{url_banco}}"],
              "path": ["banco", "propriedades"]
            }
          }
        },

        {
          "name": "Deletar por ID",
          "request": {
            "method": "DELETE",
            "header": [],
            "url": {
              "raw": "{{url_banco}}/banco/propriedades/1",
              "host": ["{{url_banco}}"],
              "path": ["banco", "propriedades", "1"]
            }
          }
        },

        {
          "name": "Buscar imóvel CAR (tabela imovel)",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{url_banco}}/imovel?car={{cod_car}}",
              "host": ["{{url_banco}}"],
              "path": ["imovel"],
              "query": [{ "key": "car", "value": "{{cod_car}}" }]
            },
            "description": "Consulta a tabela `imovel` (PostGIS) pelo código CAR."
          }
        }

      ]
    },

